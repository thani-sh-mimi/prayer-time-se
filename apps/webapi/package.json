		"hono": "^4.6.18"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.6.4",
		"drizzle-kit": "^0.31.9",
		"tsx": "^4.21.0",
		"typescript": "^5.5.2",
		"vitest": "2.1.8",
		"wrangler": "^4.5.0"
